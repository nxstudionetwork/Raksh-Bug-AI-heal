# Database
DATABASE_URL=postgresql+asyncpg://raksh:raksh_secret@db:5432/raksh
DATABASE_SYNC_URL=postgresql://raksh:raksh_secret@db:5432/raksh

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Outlook SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=raksh.bug@outlook.com
SMTP_PASSWORD=your-app-password-here
SMTP_USE_TLS=true

# AI Model
AI_MODEL_PATH=models/phishing-detection
AI_CONFIDENCE_THRESHOLD=0.5
AI_BATCH_SIZE=8
AI_MAX_TEXT_LENGTH=512

# App
APP_NAME=RAKSH
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5500,http://localhost:8000,http://localhost

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Encryption
ENCRYPTION_KEY=change-this-to-a-32-byte-hex-string
